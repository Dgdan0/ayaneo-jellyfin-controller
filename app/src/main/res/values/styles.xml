<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketDSHub" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!--
          The platform focus highlight is a faint grey that is effectively
          invisible on a 7" screen at arm's length. Every focusable view in this
          app draws its own ring instead, via ui/Styler.
        -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <!--
          Every TextView falls back to the theme, so this one line sets body text
          everywhere, including the setTypeface(typeface, BOLD) calls, which pick
          the family's 700. Titles use ui/Type explicitly.
        -->
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>
    </style>
</resources>
