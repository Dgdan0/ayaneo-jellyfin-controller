<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The reading-audio player keeps the device awake while an audiobook plays with the screen off (#16, A1). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The device is a games handheld; declaring this stops the app being
         filtered out of listings and documents what it is actually driven by. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      Required, not optional. From targetSdk 30 onwards other installed packages
      are invisible unless declared here, and getLaunchIntentForPackage returns
      null for an app that is plainly installed. The sibling project hit exactly
      this with 1Password and the failure looks like "the app isn't installed".
      The package/video declarations are retained for an optional explicit
      external-player fallback. Native Media3 playback is the primary path in
      PLAYER_PLAN.md; Findroid itself cannot accept a playable deep link.
    -->
    <queries>
        <package android:name="dev.jdtech.jellyfin" />
        <package android:name="dev.jdtech.jellyfin.debug" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.PocketDSHub">

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.pocketds.hub.playback.HubCastOptionsProvider" />

        <!--
          One Activity for the whole app. The gamepad pipeline (dispatchKeyEvent,
          onGenericMotionEvent, the Choreographer ticker, dead-zone state, the
          D-pad source latch) is per-window state that has to exist exactly once;
          separate Activities would rebuild the ticker and re-latch the D-pad
          source on every screen change.

          Appearance choices rebind retained Views in place. uiMode remains absent
          from configChanges so an operating-system configuration change uses
          normal Activity restoration. Manual accent/display choices do not
          recreate the Activity or its media session.
        -->
        <activity
            android:name=".HubActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Reading audio, apart from the video service: an audiobook that outlives its screen (#16, A1). -->
        <service
            android:name=".reader.ReadingAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- The read-along voice, held with the screen off (#49): its own session beside the audiobook's. -->
        <service
            android:name=".reader.NarrationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <service android:name=".alerts.TransferAlertJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />

        <service
            android:name=".reader.ReadingSyncJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <service
            android:name=".offline.OfflineDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".offline.OfflineBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
