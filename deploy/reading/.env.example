# Lab-only paths. Copy this file to .env and keep .env untracked.
READING_LAB_DATA_ROOT=./lab-data
READING_MEDIA_ROOT=./lab-media
READING_DERIVED_ROOT=./lab-derived
READING_SECRETS_ROOT=./lab-secrets

# Replace these placeholders with exact tags or immutable digests qualified by
# the M1 platform test. Production must never use :latest.
KAVITA_IMAGE=ghcr.io/kareadita/kavita@sha256:REPLACE_WITH_TESTED_DIGEST
STORYTELLER_IMAGE=registry.gitlab.com/storyteller-platform/storyteller@sha256:REPLACE_WITH_TESTED_DIGEST
BOOKKEEPRR_IMAGE=ghcr.io/paulcsiki/bookkeeprr:1.1.1

KAVITA_PORT=5000
STORYTELLER_PORT=8001
BOOKKEEPRR_PORT=3000
TZ=Etc/UTC
